  "levels": [
    {
      "number": 1,
      "title": "Rustig opstarten",
      "subtitle": "Vroege postoperatieve fase",
      "patientGoal": "Je knie terug rustig krijgen, volledig strekken en je dijspier weer aanzetten.",
      "focus": "Zwelling beheersen, volledige extensie, quadricepsactivatie, normaal stappen.",
      "criteria": [
        {
          "id": "vkb-1-extensie",
          "label": "Passieve extensie symmetrisch met de andere knie (0° of zelfde hyperextensie)",
          "type": "measurement",
          "test": "extensie",
          "metric": "difference",
          "operator": "<=",
          "threshold": 0,
          "patientLabel": "Je knie kan even ver strekken als je andere knie."
        },
        {
          "id": "vkb-1-flexie",
          "label": "Flexie ≥ {threshold}°",
          "type": "measurement",
          "test": "flexie",
          "metric": "injured",
          "operator": ">=",
          "threshold": 120,
          "patientLabel": "Je kan je knie ver genoeg plooien."
        },
        {
          "id": "vkb-1-slr",
          "label": "Straight leg raise zonder extensielag",
          "type": "judgement",
          "patientLabel": "Je kan je been gestrekt optillen."
        },
        {
          "id": "vkb-1-stroke",
          "label": "Zwelling: stroke test ≤ 1+",
          "type": "measurement",
          "test": "stroke-test",
          "metric": "value",
          "operator": "in",
          "values": [
            "0",
            "spoor",
            "1+"
          ],
          "patientLabel": "Je knie is nauwelijks gezwollen."
        },
        {
          "id": "vkb-1-gang",
          "label": "Normaal gangpatroon zonder krukken",
          "type": "judgement",
          "patientLabel": "Je stapt normaal, zonder krukken."
        },
        {
          "id": "vkb-1-pijn",
          "label": "Pijn bij dagelijkse activiteiten ≤ {threshold}/10",
          "type": "measurement",
          "test": "nprs-adl",
          "metric": "value",
          "operator": "<=",
          "threshold": 2,
          "patientLabel": "Je hebt weinig pijn in het dagelijks leven."
        }
      ],
      "patientFocus": [
        "We beschermen je knie en houden de zwelling onder controle.",
        "Je leert je knie volledig strekken en plooien.",
        "Je zet je dijspier weer aan.",
        "Je stapt weer normaal."
      ]
    },
    {
      "number": 2,
      "title": "Sterk worden",
      "subtitle": "Kracht en neuromusculaire controle",
      "patientGoal": "Kracht opbouwen en controle krijgen over je knie, op één been.",
      "focus": "Progressieve krachttraining (quadriceps, hamstrings, heup, kuit), single-leg controle.",
      "criteria": [
        {
          "id": "vkb-2-tijd",
          "label": "Minimum {weeks} weken postoperatief",
          "type": "minTime",
          "weeks": 12,
          "note": "Houd rekening met bijkomende letsels, bv. een meniscushechting.",
          "patientLabel": "Je knie heeft genoeg tijd gekregen om te herstellen."
        },
        {
          "id": "vkb-2-quad",
          "label": "Quadriceps isometrische kracht LSI ≥ {threshold} %",
          "type": "measurement",
          "test": "quad-iso",
          "metric": "lsi",
          "operator": ">=",
          "threshold": 80,
          "note": "Literatuur: 70–80 %. Grens instelbaar in het protocol.",
          "patientLabel": "Je dijspier is weer sterk genoeg."
        },
        {
          "id": "vkb-2-ham",
          "label": "Hamstrings isometrische kracht LSI ≥ {threshold} %",
          "patientLabel": "De spieren achteraan je dijbeen zijn sterk genoeg.",
