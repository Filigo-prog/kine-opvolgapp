        {
          "id": "ikdc",
          "label": "IKDC subjective",
          "type": "single",
          "unit": "/100",
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        {
          "id": "koos-sport",
          "label": "KOOS sport/rec",
          "type": "single",
          "unit": "/100",
          "min": 0,
          "max": 100,
          "decimals": 1
        }
      ]
    }
  ],
  "levels": [
    {
      "number": 1,
      "title": "Rustig opstarten",
      "subtitle": "Vroege postoperatieve fase",
      "patientGoal": "Je knie terug rustig krijgen, volledig strekken en je dijspier weer aanzetten.",
      "focus": "Zwelling beheersen, volledige extensie, quadricepsactivatie, normaal stappen.",
      "criteria": [
        {
          "id": "vkb-1-extensie",
          "label": "Passieve extensie symmetrisch met de andere knie (0° of zelfde hyperextensie)",
          "type": "measurement",
          "test": "extensie",
          "metric": "difference",
          "operator": "<=",
          "threshold": 0
        },
        {
          "id": "vkb-1-flexie",
          "label": "Flexie ≥ 120°",
          "type": "measurement",
          "test": "flexie",
          "metric": "injured",
          "operator": ">=",
          "threshold": 120
        },
        {
          "id": "vkb-1-slr",
          "label": "Straight leg raise zonder extensielag",
          "type": "judgement"
        },
        {
          "id": "vkb-1-stroke",
          "label": "Zwelling: stroke test ≤ 1+",
          "type": "measurement",
          "test": "stroke-test",
          "metric": "value",
          "operator": "in",
          "values": [
            "0",
            "spoor",
            "1+"
          ]
        },
        {
          "id": "vkb-1-gang",
          "label": "Normaal gangpatroon zonder krukken",
          "type": "judgement"
        },
        {
          "id": "vkb-1-pijn",
          "label": "Pijn bij dagelijkse activiteiten ≤ 2/10",
          "type": "measurement",
          "test": "nprs-adl",
          "metric": "value",
          "operator": "<=",
          "threshold": 2
        }
      ]
    },
    {
      "number": 2,
      "title": "Sterk worden",
      "subtitle": "Kracht en neuromusculaire controle",
      "patientGoal": "Kracht opbouwen en controle krijgen over je knie, op één been.",
      "focus": "Progressieve krachttraining (quadriceps, hamstrings, heup, kuit), single-leg controle.",
