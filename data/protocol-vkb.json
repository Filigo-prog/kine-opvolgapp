          "test": "ham-iso",
          "metric": "lsi",
          "operator": ">=",
          "threshold": 80,
          "note": "Literatuur: 70–80 %. Grens instelbaar in het protocol."
        },
        {
          "id": "vkb-2-stroke",
          "label": "Stroke test: 0 of spoor",
          "type": "measurement",
          "test": "stroke-test",
          "metric": "value",
          "operator": "in",
          "values": [
